{
  "name": "pipeline",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "tsx src/run.ts",
    "dry-run": "DRY_RUN=true tsx src/run.ts",
    "dev": "tsx watch src/run.ts",
    "retention": "tsx src/retention.ts",
    "check-deps": "tsx src/scripts/deps-tracker.ts",
    "worker": "tsx src/queue-worker.ts",
    "worker:enqueue": "tsx src/queue-worker.ts --enqueue",
    "worker:status": "tsx src/queue-worker.ts --status",
    "worker:requeue": "tsx src/queue-worker.ts --requeue-stale",
    "scrape": "tsx src/agents/maps-scraper.ts",
    "scrape:hvac": "tsx src/agents/maps-scraper.ts --niche hvac --city \"Austin\" --state TX --count 100",
    "scrape:daily": "tsx src/scripts/daily-scrape.ts",
    "scrape:now": "SCRAPE_TARGET=100 tsx src/scripts/daily-scrape.ts",
    "scrape:bulk": "tsx src/scripts/scrape-bulk.ts",
    "scrape:bulk:medspa": "BULK_NICHE=medspa tsx src/scripts/scrape-bulk.ts",
    "scrape:bulk:hvac": "BULK_NICHE=hvac tsx src/scripts/scrape-bulk.ts",
    "scrape:bulk:roofing": "BULK_NICHE=roofing tsx src/scripts/scrape-bulk.ts",
    "scrape:bulk:dental": "BULK_NICHE=dental tsx src/scripts/scrape-bulk.ts",
    "scrape:bulk:restaurant": "BULK_NICHE=restaurant tsx src/scripts/scrape-bulk.ts",
    "scrape:bulk:fast": "SKIP_MAPS=true tsx src/scripts/scrape-bulk.ts",
    "sheets:setup": "tsx src/scripts/setup-sheets.ts",
    "cron:install": "bash scripts/setup-cron.sh",
    "logs": "tail -f logs/daily-scrape.log",
    "outreach": "tsx src/scripts/send-outreach.ts",
    "outreach:dry": "SMS_DRY_RUN=true tsx src/scripts/send-outreach.ts",
    "outreach:t1": "OUTREACH_TIER=tier1 tsx src/scripts/send-outreach.ts",
    "outreach:t2": "OUTREACH_TIER=tier2 tsx src/scripts/send-outreach.ts",
    "sms:sheets": "tsx src/scripts/sheets-sms-outreach.ts",
    "sms:sheets:dry": "DRY_RUN=true tsx src/scripts/sheets-sms-outreach.ts",
    "sms:sheets:1k": "BATCH_SIZE=1000 tsx src/scripts/sheets-sms-outreach.ts",
    "api:deploy": "cd ../api && npx wrangler deploy",
    "report": "tsx src/scripts/run-report.ts",
    "repair": "tsx src/scripts/repair-stuck-leads.ts",
    "costs": "tsx src/scripts/costs.ts",
    "costs:total": "tsx src/scripts/costs.ts --total",
    "pricing": "tsx src/scripts/pricing.ts",
    "launch:check": "tsx src/scripts/launch-readiness.ts",
    "video:check": "tsx src/scripts/video-readiness.ts",
    "platform:worker": "tsx src/platform/runner.ts",
    "platform:once": "tsx src/platform/runner.ts --once",
    "platform:smoke": "tsx src/scripts/platform-smoke.ts",
    "regen-images": "tsx src/scripts/regen-images.ts",
    "gen-library": "node --env-file=.env --import=tsx/esm src/scripts/gen-niche-library-openai.ts",
    "gen-library:status": "node --env-file=.env -e \"const {libraryStatus}=require('./src/tools/niche-image-library');console.table(libraryStatus())\"",
    "add-domain": "tsx src/scripts/add-domain.ts",
    "domain": "tsx src/scripts/domain.ts",
    "reception": "tsx src/reception/index.ts",
    "reception:setup": "tsx src/scripts/setup-reception.ts",
    "reception:list": "tsx src/scripts/setup-reception.ts --list",
    "reception:provision": "tsx src/scripts/provision-client.ts",
    "reception:migrate": "node --env-file=.env --import=tsx/esm -e \"import pg from 'pg'; import {readFileSync} from 'fs'; const p = new pg.Pool({connectionString: process.env.DATABASE_URL}); await p.query(readFileSync('src/db/migration-reception.sql','utf8')); console.log('Done'); process.exit()\"",
    "scrape:emails": "tsx src/scripts/scrape-emails.ts",
    "migrate:v5": "node --env-file=.env --import=tsx/esm -e \"import pg from 'pg'; import {readFileSync} from 'fs'; const p = new pg.Pool({connectionString: process.env.DATABASE_URL}); await p.query(readFileSync('src/db/migration-v5.sql','utf8')); console.log('Done'); process.exit()\"",
    "growth:plan": "tsx src/scripts/run-growth-plan.ts",
    "growth:migrate": "node --env-file=.env --import=tsx/esm -e \"import pg from 'pg'; import {readFileSync} from 'fs'; const p = new pg.Pool({connectionString: process.env.DATABASE_URL}); await p.query(readFileSync('src/db/migration-v6-growth-os.sql','utf8')); await p.query(readFileSync('src/db/migration-v7-launch-foundation.sql','utf8')); await p.query(readFileSync('src/db/migration-v8-ads-foundation.sql','utf8')); await p.query(readFileSync('src/db/migration-v9-compliance-launch.sql','utf8')); await p.query(readFileSync('src/db/migration-v10-integrations.sql','utf8')); await p.query(readFileSync('src/db/migration-v19-social-publishing.sql','utf8')); await p.query(readFileSync('src/db/migration-v20-video-assets.sql','utf8')); await p.query(readFileSync('src/db/migration-v21-agency-platform.sql','utf8')); await p.query(readFileSync('src/db/migration-v22-platform-control-plane.sql','utf8')); console.log('Done'); process.exit()\""
  },
  "dependencies": {
    "@fal-ai/client": "^1.10.1",
    "@google/genai": "^2.10.0",
    "@google/generative-ai": "^0.24.1",
    "@types/ws": "^8.18.1",
    "dotenv": "^16.4.7",
    "google-auth-library": "^10.9.0",
    "libphonenumber-js": "^1.13.7",
    "pg": "^8.20.0",
    "pg-boss": "^10.4.2",
    "playwright": "^1.60.0",
    "tweetsodium": "^0.0.4",
    "twilio": "^6.0.2",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.15.3",
    "@types/pg": "^8.20.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
